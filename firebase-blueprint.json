        "targetPercentage": { "type": "number", "description": "Personal target attendance percentage (e.g. 75)" },
        "remindersEnabled": { "type": "boolean", "description": "Whether daily attendance logging reminders are enabled" },
        "reminderTiming": { "type": "string", "description": "Preferred reminder time" },
        "reminderDays": { "type": "array", "items": { "type": "string" }, "description": "Days of week to remind" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "lateTreatment", "excusedTreatment"]
    }
